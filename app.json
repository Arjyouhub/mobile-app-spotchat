{
  "expo": {
    "name": "spotchat",
    "slug": "spotchat-android",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "spotchat",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B141A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spotchat.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B141A",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "package": "com.spotchat.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET",
        "VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B141A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "358a777c-fa7d-471f-b5b9-04f62c985c89"
      }
    }
  }
}
